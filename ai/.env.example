# PayPal Credentials (sandbox)
PAYPAL_CLIENT_ID=mock_paypal_client_id
PAYPAL_CLIENT_SECRET=mock_paypal_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=mock_paypal_client_id
PAYPAL_ENV=sandbox

# Channel3 Product Search
# Promo code for hackathon: PAYPAL-HACKATHON-2026
CHANNEL3_API_KEY=mock_channel3_key

# LLM Providers
GEMINI_API_KEY=mock_gemini_key
GROQ_API_KEY=mock_groq_key
LLM_MODEL=gemini-2.5-flash

# Database (Neon Postgres fallback to in-memory)
DATABASE_URL=postgres://user:password@localhost:5432/mandate

# App Config
APP_BASE_URL=http://localhost:3000

# Testing and Demo Insurance
# USE_MOCKS=true uses local mock implementations behind same interfaces
USE_MOCKS=true

# DEMO_MODE=replay replays recorded fixtures (0 rate limit / outage risk)
DEMO_MODE=replay

